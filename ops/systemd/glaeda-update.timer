[Unit]
Description=glaeda-update every minute (a full run every 10 minutes or when the channel changed)

[Timer]
# scripts/glaeda-update PROBE_EVERY_S (test-glaeda-update.py checks they agree)
OnCalendar=*:*:00
Persistent=true
AccuracySec=1s
# spread hosts so a new release is not fetched by the whole fleet in the same second; fixed per host, so each host
# still runs once a minute
RandomizedDelaySec=30s
FixedRandomDelay=true

[Install]
WantedBy=timers.target
